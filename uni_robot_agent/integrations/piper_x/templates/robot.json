  },
  "motion_profiles": {
    "standard": {
      "max_step_m": null,
      "position_tolerance_m": null,
      "orientation_tolerance_rad": null
    },
    "approach": {
      "max_step_m": null,
      "position_tolerance_m": null,
      "orientation_tolerance_rad": null
    },
    "precision": {
      "max_step_m": null,
      "position_tolerance_m": null,
      "orientation_tolerance_rad": null
    }
  },
  "action_timeout_s": null,
  "stop_timeout_s": null,
  "feedback_max_age_s": null,
  "feedback_max_skew_s": null,
  "control_frequency_hz": null,
  "max_episode_steps": null
}
