include README.md CHANGELOG.md CONTRIBUTING.md AGENTS.md CLAUDE.md pyrightconfig.json
recursive-include docs *.md
recursive-include .github/workflows *.yml
recursive-include assets *.md *.png *.html *.pdf *.sh *.txt
recursive-include scripts *.sh *.py *.json *.md *.txt *.toml
recursive-exclude * __pycache__ *.py[cod]
prune uni_robot_agent/integrations/robodojo/resources
recursive-include examples *.sh *.py *.json *.toml *.md
prune archive
prune tests


recursive-include uni_robot_agent/integrations *.toml
recursive-include uni_robot_agent/integrations/arx_one *.md *.json *.sh *.txt *.urdf *.toml *.yaml *.cpp *.hpp *.h *.msg *.srv package.xml SHA256SUMS LICENSE NOTICE
prune uni_robot_agent/integrations/arx_one/deploy/configs/calibration
prune uni_robot_agent/integrations/arx_one/body/drivers/arx_x5/sdk
prune uni_robot_agent/integrations/arx_one/body/drivers/realsense/sdk
prune uni_robot_agent/integrations/arx_one/body/drivers/can
prune uni_robot_agent/integrations/arx_one/body/drivers/third_party
prune uni_robot_agent/integrations/arx_one/body/drivers/arx_x5/models/arx_x5_2025/meshes
recursive-include uni_robot_agent/services *.toml
